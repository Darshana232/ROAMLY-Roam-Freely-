NODE_ENV=development
PORT=4000
# Leave empty in development to use an in-memory MongoDB (auto-seeded).
MONGO_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Number of proxies in front of the API (1 locally behind Vite, 2 on Render behind Vercel)
TRUST_PROXY=1
